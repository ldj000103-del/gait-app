{
  "name": "gait-app",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node test_gait.mjs",
    "web": "node -e \"const fs=require('fs');fs.rmSync('www',{recursive:true,force:true});fs.mkdirSync('www');for(const f of ['index.html','app.js','gait.js','manifest.webmanifest','sw.js','icon.svg','privacy.html'])fs.copyFileSync(f,'www/'+f)\"",
    "sync": "npm run web && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9"
  }
}
